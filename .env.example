# Copy to .env for local overrides (optional). Never commit .env.

# Execution mode for the web app: mock | live (default: mock)
# OC_EXECUTION_MODE=mock

# Optional: WID used by the internal navigable probe (diagnostics only)
# OC_PROBE_NAVIGABLE_WID=00000000000000000000000000000001

# Optional: Bearer token for scripts/skylab_openapi_check.py (do not commit)
# OC_ACCESS_TOKEN=

# Security test harness — persona credentials (references only; values from your secret store)
# OC_SUV_USER_A=
# OC_SUV_TOKEN_A=
# OC_SKYLAB_TOKEN_A=
